{
  "name": "paperplay",
  "version": "1.1.0",
  "description": "Interactive research papers with source-linked figures and Meta AI",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "meta:check": "tsx scripts/check-meta.ts",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/build-engine-worker.mjs",
    "usage:summary": "tsx scripts/usage-summary.ts",
    "eval:corpus": "tsx scripts/evaluate-corpus.ts",
    "reproduce:merge-cost": "tsx scripts/reproduce-merge-cost.ts",
    "notices": "node scripts/dependency-notices.mjs",
    "build:hosted": "node --import tsx scripts/build-hosted.ts",
    "stage:site": "node scripts/stage-site.mjs",
    "worker:build": "node scripts/build-engine-worker.mjs",
    "prebuild": "node scripts/build-engine-worker.mjs",
    "predev": "node scripts/build-engine-worker.mjs",
    "eval:enrichment": "tsx scripts/evaluate-enrichment.ts",
    "check:reconstruction": "tsx scripts/check-pdf-reconstruction.ts",
    "benchmark:widgets": "tsx scripts/benchmark-widget-validation.ts",
    "check:custom-design": "tsx scripts/check-custom-design.ts",
    "report:scientific-corpus": "tsx scripts/report-scientific-corpus.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManuelR-T/paperplay.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ManuelR-T/paperplay/issues"
  },
  "homepage": "https://github.com/ManuelR-T/paperplay#readme",
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@next/env": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "openai": "^7.45.0",
    "pdfjs-dist": "^6.4.299",
    "quickjs-emscripten-core": "0.32.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
