# Server-side only. Copy to .env.local; never prefix the API key with NEXT_PUBLIC_.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional: exact public origin for LAN/hosted analysis (localhost works by default).
# ANALYSIS_APP_ORIGIN=https://paperplay.example
# Optional: stable signing secret; defaults to a server-only derivation from MODEL_API_KEY.
# ANALYSIS_SIGNING_SECRET=

# Durable quotas: local/single-host SQLite, shared by all processes on that volume.
# USAGE_SQLITE_PATH=.paperplay/usage.sqlite
# USAGE_HOURLY_REQUESTS=20
# USAGE_SESSION_REQUESTS=5
# USAGE_DAILY_REQUESTS=100
# USAGE_DAILY_TOKENS=2000000
# Section planning also reserves a per-paper/session budget: 8 creations and
# 1,000,000 accounted tokens by default, shared across server processes.
# Keep this SQLite file on the same persistent volume as the usage ledger.
# ENRICHMENT_BUDGET_PATH=.paperplay/enrichment-budget.sqlite
# Distributed Next/Node hosting requires Redis; the separate Sites Worker uses its injected shared D1 binding.
# Missing durable storage disables new paid work.
# PAPERPLAY_DEPLOYMENT=distributed
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# USAGE_NAMESPACE=paperplay

# Post-credit operation: stop NEW paid work, retain existing-job retrieval/cancellation.
# META_ANALYSIS_ENABLED=false
# META_CREDITS_EXPIRE_AT=2026-11-06T00:00:00Z
# Optional independent short-link signing secret (server-only).
# SHORT_LINKS_SIGNING_SECRET=
